#!/bin/sh
set -eu
expected='188038396+fukuang-dev@users.noreply.github.com'
for kind in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  identity=$(git var "$kind") || exit 1
  case "$identity" in
    *" <$expected> "*) ;;
    *) printf '%s\n' "Commit blocked: $kind must use the personal GitHub noreply email; see docs/git-isolation.md." >&2; exit 1 ;;
  esac
done
